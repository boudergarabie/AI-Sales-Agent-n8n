        "assignments": {
          "assignments": [
            {
              "id": "0915f0b8-7d09-4667-a131-d256b2fc3fda",
              "name": "product_prompt",
              "value": "=Create one realistic e-commerce product photograph for the product described below.\n\nPRODUCT INFORMATION\n\nProduct name:\n{{ $json.name_product }}\n\nCategory:\n{{ $json.category }}\n\nMaterial:\n{{ $json.material }}\n\nSeason:\n{{ $json.season }}\n\nFormality:\n{{ $json.formality_level }}\n\nDescription:\n{{ $json.description }}\n\n\nVISUAL INSTRUCTIONS\n\nCreate a clean, realistic product catalog photograph.\n\nThe product itself must be the main subject.\n\nShow the product clearly so an online customer can understand what it looks like.\n\nUse realistic fabric texture, natural proportions, accurate construction and believable materials.\n\nUse a simple neutral studio background with soft natural lighting.\n\nUse a clean 1:1 composition suitable for an online store and mobile messaging.\n\nKeep the visual style consistent with a premium but simple clothing catalog.\n\nDo not create an artistic or cinematic scene.\n\nDo not add people unless a person is necessary to clearly display the clothing.\n\nDo not add coffee, food, furniture, vehicles, plants, random accessories or unrelated objects.\n\nDo not add text.\n\nDo not create fake logos, fake brand names or invented labels.\n\nDo not invent product features that are not present in the product information.\n\nDo not invent patterns, pockets, embroidery, prints, buttons or accessories.\n\nDo not change the product category, material, main color or fundamental design.\n\nIf a visual detail is not specified, keep it simple and neutral.\n\nThe final image should look like a genuine online product catalog photograph.\n\nGenerate ONE image.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1072,
        -112
      ],
      "id": "f27e18fe-b0d7-4215-9c32-f1dcbd15ac3f",
      "name": "Edit Fields"
