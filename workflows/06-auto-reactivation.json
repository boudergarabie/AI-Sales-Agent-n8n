{
  "name": "Human Escalation - Auto Reactivation",
  "nodes": [
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const pausedAt = item.json.paused_at;\n\n  if (!pausedAt) {\n    return {\n      json: {\n        ...item.json,\n        is_expired: false,\n        pause_age_minutes: null\n      }\n    };\n  }\n\n  const pausedTime = new Date(pausedAt);\n  const now = new Date();\n\n  const ageMinutes = Math.floor(\n    (now.getTime() - pausedTime.getTime()) / 60000\n  );\n\n  return {\n    json: {\n      ...item.json,\n      pause_age_minutes: ageMinutes,\n      is_expired: ageMinutes >= 720\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
