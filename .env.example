# SETUP CHECKLIST ONLY
# The exported workflows do not automatically load this file.
# Create credentials in n8n, then replace YOUR_* placeholders in workflow nodes.
# Never commit real secrets or tokens to this repository.

# ---- Values referenced directly by workflow nodes ----
YOUR_GOOGLE_SHEET_ID=             # Google spreadsheet ID (not the full URL)
YOUR_FACEBOOK_PAGE_ID=            # Facebook Page ID
YOUR_FACEBOOK_PAGE_ACCESS_TOKEN=  # Page access token used to send Messenger replies
YOUR_TELEGRAM_CHAT_ID=            # Owner's Telegram chat ID for alerts
YOUR_ELEVENLABS_VOICE_ID=          # ElevenLabs voice ID
YOUR_IMGBB_API_KEY=               # Workflow 08 only
YOUR_N8N_DOMAIN=                  # Public HTTPS n8n domain, if referenced by your configured nodes
YOUR_WORKFLOW_ID=                 # Replace with the called workflow ID in Execute Workflow nodes

# ---- Credentials to create in n8n ----
# Google Sheets: Google OAuth2 credential using your Google Cloud OAuth Client ID + Client Secret.
# Copy the exact OAuth Redirect URL shown by n8n into Google Cloud's authorized redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
TELEGRAM_BOT_TOKEN=
FACEBOOK_GRAPH_TOKEN=             # Used for reading shared post/reel details where configured
POSTGRES_HOST=
POSTGRES_PORT=                    # Common default: 5432; confirm your server configuration
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_HOST=
REDIS_PORT=                       # Common default: 6379; confirm your server configuration
REDIS_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # Keep private; configure in n8n credentials, never commit a real value
IMGBB_API_KEY=                    # Workflow 08 only
