# Reference checklist only. n8n does NOT load this file automatically.
# Create credentials in n8n and select them in the imported workflow nodes.
# Never commit real API keys, tokens, passwords, or OAuth client secrets.

# ---- Values/placeholders used inside workflow nodes ----
YOUR_GOOGLE_SHEET_ID=
YOUR_FACEBOOK_PAGE_ID=
YOUR_FACEBOOK_PAGE_ACCESS_TOKEN=
YOUR_TELEGRAM_CHAT_ID=
YOUR_ELEVENLABS_VOICE_ID=
YOUR_IMGBB_API_KEY=                 # Workflow 08 only
YOUR_N8N_DOMAIN=
YOUR_WORKFLOW_ID=                   # Where an Execute Workflow node requires a workflow ID

# ---- Credentials to create in n8n ----
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
TELEGRAM_BOT_TOKEN=
FACEBOOK_GRAPH_TOKEN=

# Google Sheets authentication:
# Create a Google Sheets OAuth2 API credential in n8n using Google OAuth Client ID
# and Client Secret. Add the exact OAuth Redirect URL shown by n8n to the
# Google Cloud OAuth Client's Authorized redirect URIs. Do not use Service Account.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Database/service credentials (configure the corresponding n8n credentials)
POSTGRES_HOST=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_HOST=
REDIS_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
